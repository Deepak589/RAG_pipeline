# macOS
.DS_Store

# Session automation artifacts (per-machine, regenerated each session)
.claude/SESSION_SUMMARY.md
.claude/session_hooks.log
.claude/settings.local.json

# graphify knowledge graph (regenerated from code)
graphify-out/

# RAG dense-vector cache (regenerated, fingerprinted)
**/.dense_cache.npz

*.npz

# LLM response cache (stage 6 spend guards; regenerated)
**/llm_cache.sqlite

__pycache__/

# RAG eval run artifacts (timestamped, regenerated per run)
RAG/rag_stage_2/eval/results/

RAG/.env

RAG/corpus/

# Ingest outputs (100–270 MB each, regenerated by ingest.py / build_subset.py).
# Gold sets and eval results stay tracked.
**/chunks.json
**/sections.json

# Scratch / backups
*.bak.json
triage_dump.json
